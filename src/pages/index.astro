---
import portrait320 from '../assets/portrait-320.jpg';
import portrait480 from '../assets/portrait-480.jpg';
import Base from '../layouts/Base.astro';
import QualityPanel from '../components/QualityPanel.astro';
import { cv, formatRange, languageLevel, certificationStatus } from '../lib/cv';

const { name, title, description, location, photo, links, summary, experience, education, skills, certifications, languages } = cv;
const base = import.meta.env.BASE_URL;
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name,
  jobTitle: title,
  description,
  address: { '@type': 'PostalAddress', addressLocality: location.split(',')[0].trim(), addressCountry: 'DE' },
  url: new URL(base, Astro.site).href,
  image: new URL(`${base}og.png`, Astro.site).href,
  sameAs: [links.linkedin.startsWith('http') ? links.linkedin : `https://${links.linkedin}`],
};
const linkedinUrl = links.linkedin.startsWith('http') ? links.linkedin : `https://${links.linkedin}`;
---

<Base
  title={`${name} – ${title}`}
  description={description}
  image={`${base}og.png`}
  imageAlt={`${name}, ${title}`}
  structuredData={structuredData}
>
  <header class="hero" data-test="hero">
    <div class="hero-inner">
      <img
        src={portrait320.src}
        srcset={`${portrait320.src} 320w, ${portrait480.src} 480w`}
        sizes="(min-width: 48rem) 10rem, 6.5rem"
        alt={photo.alt}
        width="160"
        height="160"
        fetchpriority="high"
        decoding="async"
        class="portrait"
        data-test="hero-photo"
      />
      <div class="hero-text">
        <p class="eyebrow" data-test="hero-location">{location}</p>
        <h1 data-test="hero-name">{name}</h1>
        <p class="role" data-test="hero-title">{title}</p>
        <nav aria-label="Contact" class="contact">
          <a href={`mailto:${links.email}`} data-test="link-email">Email</a>
          <a href={linkedinUrl} rel="noopener" data-test="link-linkedin">LinkedIn</a>
        </nav>
      </div>
    </div>
  </header>

  <main id="main">
    <section aria-labelledby="h-about" data-test="about">
      <h2 id="h-about">About</h2>
      <div class="body">
      {summary.map((p) => <p>{p}</p>)}
    </div>
    </section>

    <section aria-labelledby="h-experience" data-test="experience">
      <h2 id="h-experience">Experience</h2>
      <div class="body">
      <ol class="list">
        {experience.map((e) => (
          <li data-test="experience-item">
            <h3>{e.role}</h3>
            <p class="meta">{e.company} · {e.location}</p>
            <p class="range" data-test="experience-range">{formatRange(e.start, e.end)}</p>
          </li>
        ))}
      </ol>
    </div>
    </section>

    <section aria-labelledby="h-skills" data-test="skills">
      <h2 id="h-skills">Skills</h2>
      <div class="body">
      {skills.map((s) => (
        <div data-test="skill-group">
          <h3>{s.category}</h3>
          <ul class="tags">{s.items.map((i) => <li>{i}</li>)}</ul>
        </div>
      ))}
    </div>
    </section>

    <section aria-labelledby="h-education" data-test="education">
      <h2 id="h-education">Education</h2>
      <div class="body">
      <ol class="list">
        {education.map((e) => (
          <li data-test="education-item">
            <h3>{e.degree}</h3>
            <p class="meta">{e.institution} · {e.location}</p>
            <p class="meta">{formatRange(e.start, e.end)}{e.grade ? ` · Grade ${e.grade}` : ''}</p>
            {e.note && <p>{e.note}</p>}
          </li>
        ))}
      </ol>
    </div>
    </section>

    <section aria-labelledby="h-certifications" data-test="certifications">
      <h2 id="h-certifications">Certifications</h2>
      <div class="body">
      <ul class="list">
        {certifications.map((c) => (
          <li data-test="certification-item" data-status={c.status}>
            <h3>{c.name}</h3>
            <p class="meta">{c.issuer} · {certificationStatus(c.status, c.date)}</p>
          </li>
        ))}
      </ul>
    </div>
    </section>

    <section aria-labelledby="h-languages" data-test="languages">
      <h2 id="h-languages">Languages</h2>
      <div class="body">
      <ul class="list">
        {languages.map((l) => (
          <li data-test="language-item">{l.name} <span class="meta">– {languageLevel(l.level)}</span></li>
        ))}
      </ul>
    </div>
    </section>

    <QualityPanel />
  </main>

  <footer data-test="footer">
    <p>© {new Date().getFullYear()} {name}</p>
  </footer>
</Base>
